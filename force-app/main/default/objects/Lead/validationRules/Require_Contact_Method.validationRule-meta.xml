<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Contact_Method</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(ISBLANK(Email), ISBLANK(Phone))]]></errorConditionFormula>
    <errorMessage>Enter at least one contact method: Email or Phone.</errorMessage>
</ValidationRule>
