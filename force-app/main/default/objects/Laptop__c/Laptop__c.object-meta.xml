<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>The Laptop object stores laptop inventory details. It captures Model to identify each device. Commonly used for tracking laptop assets.</description>
    <enableActivities>true</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Laptop</label>
    <nameField>
        <label>Laptop Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Laptops</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
