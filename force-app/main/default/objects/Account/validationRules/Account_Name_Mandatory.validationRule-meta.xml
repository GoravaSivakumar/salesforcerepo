<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Name_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), ISBLANK(Name))</errorConditionFormula>
    <errorMessage>Account Name is mandatory</errorMessage>
</ValidationRule>