<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Name_Mandatory</fullName>
    <active>true</active>
    <description>Ensures that Account Name is mandatory when creating an account</description>
    <errorConditionFormula>ISBLANK(Name)</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Account name is mandatory</errorMessage>
</ValidationRule>