<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Billing_Country</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(BillingCountry), ISCHANGED(BillingCountry))</errorConditionFormula>
    <errorMessage>Billing Country is required.</errorMessage>
</ValidationRule>