<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Phone_On_Create</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), ISBLANK(Phone__c))</errorConditionFormula>
    <errorDisplayField>Phone__c</errorDisplayField>
    <errorMessage>Phone field should not be blank.</errorMessage>
</ValidationRule>
