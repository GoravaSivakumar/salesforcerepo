<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CloseDate_Required_At_Negotiation</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[
AND(
    ISPICKVAL(StageName, "Negotiation"),
    ISBLANK(CloseDate)
)
]]></errorConditionFormula>
    <errorMessage>CloseDate is required when Stage is Negotiation.</errorMessage>
</ValidationRule>