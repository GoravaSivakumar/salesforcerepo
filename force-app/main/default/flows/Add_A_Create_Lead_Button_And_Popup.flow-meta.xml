  <description>Screen Flow for creating a Lead from the Leads page. Requires Last Name and Company, and requires either Email or Phone. Status defaults to New - Not Contacted and Rating defaults to Warm.</description>
  <label>Create Lead</label>
  <processType>Flow</processType>
  <recordCreates>
    <name>Create_Lead</name>
    <label>Create Lead</label>
    <locationX>100</locationX>
    <locationY>400</locationY>
    <connector>
      <targetReference>Screen_Complete</targetReference>
    </connector>
    <faultConnector>
      <targetReference>Handle_DML_Error</targetReference>
    </faultConnector>
    <inputAssignments>
      <field>FirstName</field>
      <value>
        <elementReference>FirstName</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>LastName</field>
      <value>
        <elementReference>LastName</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Company</field>
      <value>
        <elementReference>Company</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Email</field>
      <value>
        <elementReference>Email</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>LeadSource</field>
      <value>
        <elementReference>LeadSource</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>MobilePhone</field>
      <value>
        <elementReference>MobilePhone</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Phone</field>
      <value>
        <elementReference>Phone</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>ProductInterest__c</field>
      <value>
        <elementReference>ProductInterest</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Rating</field>
      <value>
        <elementReference>Rating</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Description</field>
      <value>
        <elementReference>Description</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Status</field>
      <value>
        <elementReference>Status</elementReference>
      </value>
    </inputAssignments>
    <object>Lead</object>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </recordCreates>
  <runInMode>DefaultMode</runInMode>
  <screens>
    <name>Screen_Complete</name>
    <label>Lead Created</label>
    <locationX>100</locationX>
    <locationY>550</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Complete_Message</name>
      <fieldType>DisplayText</fieldType>
      <fieldText>&lt;p&gt;&lt;b&gt;Lead created successfully.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Click &lt;b&gt;Finish&lt;/b&gt; to close this flow.&lt;/p&gt;</fieldText>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Create_Lead</name>
    <label>Create Lead</label>
    <locationX>100</locationX>
    <locationY>250</locationY>
    <allowBack>false</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <connector>
      <targetReference>Create_Lead</targetReference>
    </connector>
    <fields>
      <name>Create_Lead_Instructions</name>
      <fieldType>DisplayText</fieldType>
      <fieldText>&lt;p&gt;Enter the lead details. Last Name and Company are required. Provide an Email address, a Phone number, or both.&lt;/p&gt;</fieldText>
    </fields>
    <fields>
      <name>FirstName</name>
      <dataType>String</dataType>
      <fieldText>First Name</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>LastName</name>
      <dataType>String</dataType>
      <fieldText>Last Name</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>Company</name>
      <dataType>String</dataType>
      <fieldText>Company</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>true</isRequired>
    </fields>
    <fields>
      <name>Email</name>
      <dataType>String</dataType>
      <fieldText>Email</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>false</isRequired>
      <validationRule>
        <errorMessage>Enter an Email address or a Phone number to create the lead.</errorMessage>
        <formulaExpression>OR(NOT(ISBLANK({!Email})), NOT(ISBLANK({!Phone})))</formulaExpression>
      </validationRule>
    </fields>
    <fields>
      <name>LeadSource</name>
      <choiceReferences>LeadSource_Web</choiceReferences>
      <choiceReferences>LeadSource_Phone_Inquiry</choiceReferences>
      <choiceReferences>LeadSource_Partner_Referral</choiceReferences>
      <choiceReferences>LeadSource_Purchased_List</choiceReferences>
      <choiceReferences>LeadSource_Other</choiceReferences>
      <dataType>String</dataType>
      <fieldText>Lead Source</fieldText>
      <fieldType>DropdownBox</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>MobilePhone</name>
      <dataType>String</dataType>
      <fieldText>Mobile Phone</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>Phone</name>
      <dataType>String</dataType>
      <fieldText>Phone</fieldText>
      <fieldType>InputField</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>ProductInterest</name>
      <choiceReferences>ProductInterest_GC1000</choiceReferences>
      <choiceReferences>ProductInterest_GC5000</choiceReferences>
      <choiceReferences>ProductInterest_GC3000</choiceReferences>
      <dataType>String</dataType>
      <fieldText>Product/Service Interest</fieldText>
      <fieldType>DropdownBox</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>Rating</name>
      <choiceReferences>Rating_Hot</choiceReferences>
      <choiceReferences>Rating_Warm</choiceReferences>
      <choiceReferences>Rating_Cold</choiceReferences>
      <dataType>String</dataType>
      <defaultValue>
        <stringValue>Warm</stringValue>
      </defaultValue>
      <fieldText>Rating</fieldText>
      <fieldType>DropdownBox</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>Description</name>
      <dataType>String</dataType>
      <fieldText>Description</fieldText>
      <fieldType>LargeTextArea</fieldType>
      <isRequired>false</isRequired>
    </fields>
    <fields>
      <name>Status</name>
      <choiceReferences>Status_Open_Not_Contacted</choiceReferences>
      <choiceReferences>Status_Working_Contacted</choiceReferences>
      <choiceReferences>Status_Closed_Converted</choiceReferences>
      <choiceReferences>Status_Closed_Not_Converted</choiceReferences>
      <choiceReferences>Status_New_Not_Contacted</choiceReferences>
      <dataType>String</dataType>
      <defaultValue>
        <stringValue>New - Not Contacted</stringValue>
      </defaultValue>
      <fieldText>Status</fieldText>
      <fieldType>DropdownBox</fieldType>
      <isRequired>true</isRequired>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <screens>
    <name>Screen_Error</name>
    <label>Lead Creation Error</label>
    <locationX>100</locationX>
    <locationY>700</locationY>
    <allowBack>true</allowBack>
    <allowFinish>true</allowFinish>
    <allowPause>false</allowPause>
    <fields>
      <name>Error_Message</name>
      <fieldType>DisplayText</fieldType>
      <fieldText>&lt;p&gt;&lt;b&gt;The lead could not be saved.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!var_ErrorMessage}&lt;/p&gt;</fieldText>
    </fields>
    <showFooter>true</showFooter>
    <showHeader>true</showHeader>
  </screens>
  <start>
    <locationX>100</locationX>
    <locationY>100</locationY>
    <connector>
      <targetReference>Screen_Create_Lead</targetReference>
    </connector>
  </start>
  <status>Draft</status>
  <variables>
    <name>var_ErrorMessage</name>
    <dataType>String</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
</Flow>
